<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NikonLink" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0C0C0D</item>
        <item name="android:statusBarColor">#0C0C0D</item>
        <item name="android:navigationBarColor">#0C0C0D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">#FDE804</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_foreground</item>
