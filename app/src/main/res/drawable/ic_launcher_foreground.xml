<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- NikonLink mark: a camera whose lens holds a downward transfer arrow.
         Everything sits inside the adaptive-icon safe circle so launcher masks
         (round, squircle, teardrop) never crop the silhouette. -->

    <!-- Camera body -->
    <path
        android:fillColor="#101010"
        android:pathData="M40,40 H68 A12,12 0 0 1 80,52 V68 A12,12 0 0 1 68,80 H40 A12,12 0 0 1 28,68 V52 A12,12 0 0 1 40,40 Z" />

    <!-- Viewfinder hump -->
    <path
        android:fillColor="#101010"
        android:pathData="M41,40 V36 A4,4 0 0 1 45,32 H63 A4,4 0 0 1 67,36 V40 Z" />

    <!-- Lens opening -->
    <path
        android:fillColor="#FFCD00"
        android:pathData="M54,44 A16,16 0 1 1 53.99,44 Z" />

    <!-- Transfer arrow, pointing down: images leaving the camera -->
    <path
        android:pathData="M54,51 V65"
        android:strokeColor="#101010"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M47,59 L54,67 L61,59"
        android:strokeColor="#101010"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
